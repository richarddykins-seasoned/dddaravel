{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "seasoned-digital/dddaravel",
    "type": "project",
    "description": "The skeleton application for Domain Driven Design Laravel.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.12",
        "laravel/passport": "^13.2",
        "laravel/tinker": "^2.10.1",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-health": "^1.34",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "jasonmccreary/laravel-test-assertions": "^2.8",
        "larastan/larastan": "^3.7",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/phpinsights": "^2.13",
        "peckphp/peck": "^0.2.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-drift": "^4.0",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-mutate": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^12.3",
        "rector/rector": "^2.2",
        "spatie/laravel-data": "^4.17",
        "spatie/laravel-http-logger": "^1.11",
        "spatie/laravel-mailable-test": "^2.4",
        "spatie/laravel-ray": "^1.40",
        "spaze/phpstan-disallowed-calls": "^4.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Domain\\": "Domain/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "php artisan serve"
        ],
        "frankenphp": [
            "Composer\\Config::disableProcessTimeout",
            "frankenphp run --config Caddyfile"
        ],
        "frankenphp:dev": [
            "Composer\\Config::disableProcessTimeout",
            "frankenphp run --config Caddyfile"
        ],
        "frankenphp:octane": [
            "php artisan octane:frankenphp --host=0.0.0.0 --port=8000"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "vendor/bin/pest"
        ],
        "test:unit": [
            "vendor/bin/pest --testsuite=Unit"
        ],
        "test:feature": [
            "vendor/bin/pest --testsuite=Feature"
        ],
        "test:coverage": [
            "vendor/bin/pest --coverage"
        ],
        "test:coverage:min": [
            "vendor/bin/pest --coverage --min=70"
        ],
        "test:coverage:html": [
            "vendor/bin/pest --coverage --coverage-html=storage/coverage"
        ],
        "test:arch": [
            "vendor/bin/pest --testsuite=Feature --filter=ArchitectureTest"
        ],
        "test:drift": [
            "vendor/bin/pest --drift"
        ],
        "test:mutate": [
            "vendor/bin/pest --mutate"
        ],
        "spell:check": [
            "vendor/bin/peck"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "analyse:baseline": [
            "vendor/bin/phpstan analyse --memory-limit=2G --generate-baseline"
        ],
        "format": [
            "vendor/bin/pint"
        ],
        "format:check": [
            "vendor/bin/pint --test"
        ],
        "refactor": [
            "vendor/bin/rector process"
        ],
        "refactor:dry": [
            "vendor/bin/rector process --dry-run"
        ],
        "insights": [
            "vendor/bin/phpinsights --no-interaction --min-quality=80 --min-complexity=80 --min-architecture=80 --min-style=80"
        ],
        "insights:fix": [
            "vendor/bin/phpinsights --fix --no-interaction"
        ],
        "quality:check": [
            "@format:check",
            "@analyse",
            "@refactor:dry",
            "@spell:check",
            "@test"
        ],
        "quality:check:coverage": [
            "@format:check",
            "@analyse",
            "@refactor:dry",
            "@spell:check",
            "@test:coverage:min"
        ],
        "quality:fix": [
            "@format",
            "@refactor",
            "@insights:fix"
        ],
        "quality:all": [
            "@quality:fix",
            "@quality:check",
            "@insights"
        ],
        "pre-commit": [
            "@quality:check"
        ],
        "post-install-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
