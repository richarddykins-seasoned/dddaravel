parameters:
    level: max
    paths:
        - app/
        - config/
        - database/
        - routes/
        - tests/

    # Enforce class-based tests by detecting function-style Pest tests  
    # This helps maintain PHPStan compatibility
    reportUnmatchedIgnoredErrors: false
    
    # Disallowed function calls - prevent debug code in production
    disallowedFunctionCalls:
        - 
            function: 'dd()'
            message: 'Use proper logging instead of dd()'
        -
            function: 'dump()' 
            message: 'Use proper logging instead of dump()'
        -
            function: 'var_dump()'
            message: 'Use proper logging instead of var_dump()'
        -
            function: 'print_r()'
            message: 'Use proper logging instead of print_r()'
    
    # Ignored errors (customize as needed)
    ignoreErrors:
        # Detect function-style Pest tests and suggest class-based alternatives
        - '#Function (test|it)\(\) should not be used\. Use class-based tests for PHPStan compatibility\.#'
        
        # Pest architectural testing methods
        - '#Call to an undefined method Pest\\PendingCalls\\TestCall::expect\(\)#'
        - '#Cannot access property \$not on mixed#'
        - '#Cannot call method .* on mixed#'
        - '#Call to method .* with .* will always evaluate to true#'
        - '#Dynamic call to static method PHPUnit\\Framework\\Assert::.*\(\)#'
        
        # Laravel TestResponse false positives - these are instance methods, not static
        # This is a known issue with Larastan/PHPStan where some TestResponse methods
        # are incorrectly identified as static method calls
        - '#Dynamic call to static method Illuminate\\Http\\Response::status\(\)#'
        - '#Dynamic call to static method Illuminate\\Http\\Response::getContent\(\)#'
        - '#Dynamic call to static method Symfony\\Component\\HttpFoundation\\Response::getStatusCode\(\)#'
        - '#Dynamic call to static method Symfony\\Component\\HttpFoundation\\Response::status\(\)#'
        
    # Excluded files
    excludePaths:
        - storage/
        - vendor/
        - bootstrap/cache/
        - public/
        - .phpstorm.meta.php (?)
        - _ide_helper*.php (?)
