{
    "preset": "laravel",
    "ignore": {
        "words": [
            "php",
            "caddyfile",
            "commitlint",
            "filesystems",
            "frankenphp",
            "phpstan",
            "rector",
            "larastan",
            "sanctum",
            "octane",
            "tinker",
            "artisan",
            "dddaravel",
            "pestphp",
            "peckphp",
            "balancer",
            "middlewares",
            "joo",
            "joo's",
            "ddd",
            "dto",
            "dtos",
            "deserialization",
            "webmozart",
            "whitespace",
            "activitylog"
        ],
        "paths": [
            "vendor\/",
            "node_modules\/",
            "storage\/",
            "bootstrap\/cache\/",
            ".git\/"
        ]
    }
}