{
    "preset": "laravel",
    "ignore": {
        "words": [
            "php",
            "caddyfile",
            "commitlint",
            "filesystems",
            "frankenphp",
            "phpstan",
            "rector",
            "larastan",
            "sanctum",
            "octane",
            "tinker",
            "artisan",
            "gigistry",
            "pestphp",
            "peckphp",
            "balancer",
            "middlewares",
            "joo",
            "joo's",
            "ddd",
            "dto",
            "dtos",
            "deserialization",
