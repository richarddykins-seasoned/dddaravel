#!/bin/bash

# Commit Message Validation Hook
# Validates conventional commit format: type(scope?): description

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m' 
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

# Read the commit message from the file
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip validation for merge commits, revert commits, and other automated commits
if [[ $COMMIT_MSG =~ ^(Merge|Revert|fixup!|squash!) ]]; then
    print_success "Automated commit message - skipping validation"
    exit 0
fi

# Conventional Commit Pattern
# type(scope): description
# 
# Types: feat, fix, docs, style, refactor, test, chore, build, ci, perf
PATTERN='^(feat|fix|docs|style|refactor|test|chore|build|ci|perf)(\(.+\))?: .{1,50}'

if [[ ! $COMMIT_MSG =~ $PATTERN ]]; then
    echo ""
    print_error "Invalid commit message format!"
    echo ""
    echo "📝 Conventional Commit Format Required:"
    echo "   type(scope?): description"
    echo ""
    echo "📋 Valid types:"
    echo "   feat     - New feature"
    echo "   fix      - Bug fix"
    echo "   docs     - Documentation changes"
    echo "   style    - Code style changes (formatting, etc.)"
    echo "   refactor - Code refactoring"
    echo "   test     - Adding or updating tests"
    echo "   chore    - Maintenance tasks"
    echo "   build    - Build system changes"
    echo "   ci       - CI/CD changes"
    echo "   perf     - Performance improvements"
    echo ""
    echo "✅ Valid examples:"
    echo "   feat: add user authentication"
    echo "   fix(auth): resolve login redirect issue"
    echo "   docs: update API documentation"
    echo "   refactor(service): simplify user creation logic"
    echo ""
    echo "❌ Your message:"
    echo "   $COMMIT_MSG"
    echo ""
    exit 1
fi

# Additional validations - check only first line length
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n 1)
if [[ ${#FIRST_LINE} -gt 72 ]]; then
    print_error "First line too long (${#FIRST_LINE} chars). Keep it under 72 characters."
    echo "   First line: $FIRST_LINE"
    exit 1
fi

# Check for imperative mood (basic check)
DESCRIPTION=$(echo "$COMMIT_MSG" | sed 's/^[^:]*: //')
if [[ $DESCRIPTION =~ ^(added|fixed|updated|changed|removed) ]]; then
    echo ""
    print_error "Use imperative mood in description (e.g., 'add' not 'added')"
    echo "   Current: $DESCRIPTION"
    echo "   Better:  $(echo "$DESCRIPTION" | sed 's/added/add/g; s/fixed/fix/g; s/updated/update/g; s/changed/change/g; s/removed/remove/g')"
    echo ""
    exit 1
fi

print_success "Commit message format is valid"