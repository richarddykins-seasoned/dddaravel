APP_NAME=DDDaravel
APP_ENV=testing
APP_KEY=base64:f2yJT04FpKIJK5DUd5lMmi7qMTyNtJPPo0sZR1eCt04=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Testing Database Configuration - SQLite
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_TRANSACTION_MODE=IMMEDIATE

# Fast testing session and cache
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Fast cache for testing
CACHE_STORE=array

# Mail testing
MAIL_MAILER=array
MAIL_FROM_ADDRESS="test@dddaravel.test"
MAIL_FROM_NAME="${APP_NAME}"

# Disable external services in testing
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

# Health check specific settings
HEALTH_NOTIFICATIONS_ENABLED=false
HEALTH_RESULT_STORE=eloquent
HEALTH_KEEP_HISTORY_FOR_DAYS=7
