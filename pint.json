{
    "preset": "laravel",
    "rules": {
        "no_unused_imports": true,
        "trailing_comma_in_multiline": true,
        "blank_line_before_statement": {
            "statements": ["return"]
        },
        "concat_space": {
            "spacing": "one"
        },
        "single_line_comment_style": {
            "comment_types": ["hash"]
        },
        "phpdoc_order": true,
        "no_extra_blank_lines": {
            "tokens": [
                "extra",
                "throw",
                "use"
            ]
        }
    },
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor",
        "node_modules"
    ]
}
